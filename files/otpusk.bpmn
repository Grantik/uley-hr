<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Otpusk" targetNamespace="urn:uley-hr:bpmn:otpusk">
  <bpmn:process id="Process_Otpusk" name="Отпуск" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_0" name="Работник">
        <bpmn:flowNodeRef>wishes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handover</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Руководитель команды">
        <bpmn:flowNodeRef>agree</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>same</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Кадровое делопроизводство">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>annual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>change</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>allowed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hasdate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>closed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>leave</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Руководитель компании">
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_4" name="Бухгалтерия">
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Новый график или заявка">
      <bpmn:documentation>Регламент согласования отпусков, пункты 1.2 и 1.5. Исходные события: подготовка годового графика, плановая дата или запрос на изменение.</bpmn:documentation>
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="annual" name="Готовится график?">
      <bpmn:documentation>Трудовой кодекс, статья 123. Годовое утверждение и исполнение конкретного отпуска — разные шаги.</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="wishes" name="Пожелания и остатки">
      <bpmn:documentation>Регламент согласования отпусков, пункты 1.2 и 1.5; Трудовой кодекс, статьи 123–124. Уточнить рабочие годы, пожелания и право на удобное время. Разбивка остатков по годам — предлагаемая проверка.</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="draft" name="Подготовить график">
      <bpmn:documentation>Трудовой кодекс, статьи 123 и 372. Проверить сроки, учёт мнения выборного профсоюзного органа при наличии, даты старых дней и замещение.</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="approve" name="Утвердить график">
      <bpmn:documentation>Трудовой кодекс, статья 123. Решает работодатель. Порядок подготовки и полномочия подписанта уточнить; принять график в срок.</bpmn:documentation>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="change" name="Даты вне графика?">
      <bpmn:documentation>Правила внутреннего трудового распорядка, пункт 4.18; Трудовой кодекс, статьи 123–125. По графику действует утверждённая дата. В Правилах всё ещё требуется заявление: как снять противоречие, проверяют юристы.</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="request" name="Запросить новые даты">
      <bpmn:documentation>Регламент согласования отпусков, пункт 2.4; Правила внутреннего трудового распорядка, пункты 4.15 и 4.18. Если меняется дата или отпуск делится, оформить основание и согласие там, где оно требуется.</bpmn:documentation>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="agree" name="Проверить и согласовать">
      <bpmn:documentation>Регламент согласования отпусков, пункт 2.4; Трудовой кодекс, статьи 124–125. Руководитель сверяет замещение; кадры проверяют основание. Право на обязательный отпуск не превращается в право руководителя отказать.</bpmn:documentation>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="allowed" name="Изменение оформлено?">
      <bpmn:documentation>Трудовой кодекс, статьи 123–125. Без законного основания новые даты не применяются. Если была утверждённая дата, она остаётся в силе.</bpmn:documentation>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="same" name="Проверить исходную дату">
      <bpmn:documentation>Трудовой кодекс, статьи 123–124. Если исходная дата есть — исполняем её. Если нет — возвращаем на уточнение, не отправляем в отпуск без основания.</bpmn:documentation>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="hasdate" name="Есть дата по графику?">
      <bpmn:documentation>Трудовой кодекс, статьи 123–124. Нет даты — вернуть запрос на уточнение.</bpmn:documentation>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="closed" name="Запрос на уточнении">
      <bpmn:documentation>Трудовой кодекс, статьи 123–124. Новые даты не оформлены.</bpmn:documentation>
      <bpmn:incoming>Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="notice" name="Известить под подпись">
      <bpmn:documentation>Трудовой кодекс, статья 123; Правила внутреннего трудового распорядка, пункт 4.18. Не позднее чем за две недели; напоминание по почте не заменяет подпись.</bpmn:documentation>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="pay" name="Начислить и выплатить">
      <bpmn:documentation>Положение об оплате труда, премировании и дополнительных социальных мероприятиях, пункт 10.12; Трудовой кодекс, статья 136. Не позднее чем за три дня до начала; проверить и убрать из внутреннего правила зависимость срока от заявления.</bpmn:documentation>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="handover" name="Передать дела">
      <bpmn:documentation>Правила внутреннего трудового распорядка, пункт 4.19; Регламент согласования отпусков, раздел 3. За два дня по действующим Правилам; кто подменяет и как фиксируются задачи. Не считать передачу автоматической солидарной ответственностью.</bpmn:documentation>
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="leave" name="Отпуск и учёт дней">
      <bpmn:documentation>Правила внутреннего трудового распорядка, пункты 4.11–4.21; Трудовой кодекс, статьи 124–125. Учесть фактический отдых. При болезни, отзыве или ином законном исключении оформить новую дату остатка.</bpmn:documentation>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end" name="Отдых учтён">
      <bpmn:documentation>Трудовой кодекс, статьи 121–124. Сверить фактически использованные и оставшиеся дни.</bpmn:documentation>
      <bpmn:incoming>Flow_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="start" targetRef="annual" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="annual" targetRef="wishes" name="Да" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="annual" targetRef="change" name="Нет" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="wishes" targetRef="draft" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="draft" targetRef="approve" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="approve" targetRef="change" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="change" targetRef="request" name="Да" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="change" targetRef="notice" name="Нет" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="request" targetRef="agree" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="agree" targetRef="allowed" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="allowed" targetRef="notice" name="Да" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="allowed" targetRef="same" name="Нет" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="same" targetRef="hasdate" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="hasdate" targetRef="closed" name="Нет" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="hasdate" targetRef="notice" name="Да" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="notice" targetRef="pay" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="pay" targetRef="handover" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="handover" targetRef="leave" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="leave" targetRef="end" />
  </bpmn:process>
